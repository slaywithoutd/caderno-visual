---
/* Modo Consulta de uma aula: o mesmo conteúdo do modo Leitura, organizado por conceito.
   Texto em consulta.html; figuras e loops vêm do conteudo.html (ver montarConsulta no catálogo). */
import Aula from '../../../../layouts/Aula.astro';
import Cartoes from '../../../../components/Cartoes.astro';
import { aulas, materia, modulo, glossarioDaAula, hrefGlossario, montarConsulta, tempoLeitura, htmlTempo, rotuloAula } from '../../../../lib/catalogo.js';

export function getStaticPaths() {
  return aulas.filter((a) => a.consulta).map((a) => ({ params: { modulo: a.modulo, materia: a.materia, aula: a.slug }, props: { aula: a } }));
}
const { aula } = Astro.props;
const mat = materia(aula.modulo, aula.materia);
const mod = modulo(aula.modulo);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const C = montarConsulta(aula);
const html = C.html.replaceAll('href="/', `href="${base}/`);

/* sumário: grupos (data-grupo) viram rótulos, seções viram links */
const secoes = [];
let grupo = null;
for (const s of C.secoes) {
  if (s.grupo && s.grupo !== grupo) { grupo = s.grupo; secoes.push([`@${grupo}`, grupo]); }
  secoes.push([s.id, s.titulo]);
}
const titulo = (id) => C.secoes.find((s) => s.id === id)?.titulo;

/* cartões e cola agrupados pelas seções (3º item de cada entrada em revisao.js) */
const agrupar = (lista) => {
  const g = new Map();
  for (const item of lista) { const sec = titulo(item[2]) ? item[2] : ''; if (!g.has(sec)) g.set(sec, []); g.get(sec).push(item); }
  const ordem = [...C.secoes.map((s) => s.id), ''];
  return [...g.entries()].sort((a, b) => ordem.indexOf(a[0]) - ordem.indexOf(b[0])).map(([sec, itens]) => ({ sec, nome: titulo(sec) || 'Geral', itens }));
};
const gruposCartoes = agrupar(aula.cartoes);
const gruposCola = agrupar(aula.cola);
if (aula.cartoes.length) secoes.push(['revisao', 'Revisão rápida']);
if (aula.cola.length) secoes.push(['cola', 'Cola de uma página']);
const temFontes = !!aula.fontes?.length;
if (temFontes) secoes.push(['fontes', 'Fontes e escopo']);

/* definições da barra lateral: os termos desta aula, com a seção onde cada um mora */
const defs = Object.entries(aula.glossario)
  .map(([k, e]) => ({ k, t: e.t, d: e.d, f: e.f || '', m: e.m, sec: C.secaoDe[k] || '' }))
  .sort((a, b) => a.t.localeCompare(b.t, 'pt-BR', { sensitivity: 'base' }));
const jsonDefs = JSON.stringify(defs).replace(/</g, '\\u003c');
const jsonGl = JSON.stringify({ termos: glossarioDaAula(aula), listar: Object.keys(aula.glossario), global: hrefGlossario, secaoDe: C.secaoDe }).replace(/</g, '\\u003c');
const modo = { atual: 'consulta' };
const tempo = tempoLeitura({ html: C.html, extras: [...aula.cartoes.flat(), ...aula.cola.flat()].join(' '), cartoes: aula.cartoes.length });
---
<Aula titulo={aula.titulo} rotulo={rotuloAula(aula)} materia={mat} modulo={mod} secoes={secoes} descricao={aula.resumo} modo={modo}>
  <div data-aula={aula.id} id="aula-root" class="cs-root">
    <header class="hero prose cs-hero" id="top">
      <div class="kicker">{aula.tema} · {rotuloAula(aula)}</div>
      <h1>{aula.titulo}</h1>
      <Fragment set:html={htmlTempo(tempo)} />
      <p class="cs-ajuda">Um conceito por seção, só o essencial à vista; o resto abre em <b>Detalhes</b>. Procure um termo em <b>Definições</b>. <button type="button" class="cs-tudo" id="cs-tudo" aria-pressed="false">Abrir todos os detalhes</button></p>
    </header>
    <Fragment set:html={html} />
  </div>

  {gruposCartoes.length > 0 && (
    <section class="cs cs-fim" id="revisao">
      <h2>Revisão rápida</h2>
      {gruposCartoes.map((g) => (
        <Fragment>
          <h3>{g.sec ? <a href={`#${g.sec}`}>{g.nome}</a> : g.nome}</h3>
          <Cartoes cartoes={g.itens} />
        </Fragment>
      ))}
    </section>
  )}
  {gruposCola.length > 0 && (
    <section class="cs cs-fim" id="cola">
      <h2>Cola de uma página</h2>
      <div class="cheat cs-cola">
        {gruposCola.map((g) => (
          <div class="cs-cola-grupo">
            <div class="cs-cola-nome">{g.nome}</div>
            {g.itens.map(([t, x]) => <div><b set:html={t} />: <span set:html={x} /></div>)}
          </div>
        ))}
      </div>
    </section>
  )}

  {temFontes && (
    <section class="fontes" id="fontes">
      <h2>Fontes e escopo</h2>
      <ul>{aula.fontes.map((fonte) => <li>{fonte.url ? <a href={fonte.url} target="_blank" rel="noopener">{fonte.titulo}</a> : <span>{fonte.titulo}</span>}{fonte.nota && <span> · {fonte.nota}</span>}</li>)}</ul>
      {aula.observacao && <p class="muted">{aula.observacao}</p>}
    </section>
  )}

  <aside class="defs" id="defs" slot="direita" aria-label="Definições">
    <div class="puxador puxador-defs" data-painel="defs" role="separator" aria-orientation="vertical" aria-label="Largura das definições" title="Arraste para mudar a largura"></div>
    <div class="defs-head">
      <span class="defs-tit">Definições</span>
      <button class="defs-fechar" id="defs-fechar" type="button" aria-label="Recolher definições" title="Recolher definições" aria-controls="defs">›</button>
    </div>
    <input type="search" id="defs-q" placeholder={`Buscar entre ${defs.length} termos…`} aria-label="Buscar definição" autocomplete="off" />
    <div class="defs-lista" id="defs-lista"></div>
    <p class="defs-vazio" id="defs-vazio" hidden>Nenhum termo encontrado.</p>
    <script type="application/json" id="defs-data" set:html={jsonDefs}></script>
  </aside>
  <button class="defs-btn" id="defs-btn" type="button" slot="direita" aria-controls="defs" aria-expanded="true">‹ Definições</button>
  <script type="application/json" id="gl-data" set:html={jsonGl}></script>
</Aula>

<script>
  import { initChrome } from '../../../../lib/chrome.js';
  import { initGlossarioDaPagina } from '../../../../lib/glossary.js';
  import { initCartoes } from '../../../../lib/cartoes.js';
  import { initOculos } from '../../../../lib/oculos.js';
  import { initDefinicoes, initCompacto } from '../../../../lib/consulta.js';
  const entradas = import.meta.glob('../../../../aulas/*/*/*/index.js');
  const id = document.getElementById('aula-root').dataset.aula;
  const carregar = entradas[`../../../../aulas/${id}/index.js`];
  initCompacto();
  (carregar ? carregar() : Promise.resolve()).finally(() => {
    initGlossarioDaPagina();
    initDefinicoes();
    initCartoes();
    initChrome();
    initOculos();
  });
</script>
