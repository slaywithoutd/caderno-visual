---
/* Seção do glossário. Os cartões são montados no navegador por lib/glossary.js a partir do JSON
   embutido aqui. `termos` é o glossário global (todos os termos viram link no texto); `listar`
   são as chaves que aparecem como cartão nesta página. */
const { termos, listar = Object.keys(termos), global = null, num, titulo = 'Glossário', intro = 'Todo termo com sublinhado pontilhado no texto abre aqui como um cartão. Os blocos <b>"pra ir além"</b> não são necessários para a prova: servem para quando a definição curta não bastar.' } = Astro.props;
const json = JSON.stringify({ termos, listar, global }).replace(/</g, '\\u003c');
---
<hr class="sep" />
<section class="chap" id="glossario">
  {num && <span class="num">{num}</span>}
  <h2>{titulo}</h2>
  <p set:html={intro} />
  <div class="gl-tools">
    <input type="text" id="gl-search" placeholder="Buscar termo…" aria-label="Buscar no glossário" />
    <div class="gl-letters" id="gl-letters"></div>
  </div>
  <div id="gl-list"></div>
  <p class="muted" id="gl-empty" hidden>Nenhum termo encontrado.</p>
  <script type="application/json" id="gl-data" set:html={json}></script>
</section>
