---
/* Layout das páginas de leitura (aula e revisão): sidebar flutuante com sumário,
   barra de progresso, popover do glossário e o miolo da página. */
import Base from './Base.astro';
import { site, url } from '../lib/catalogo.js';
const { titulo, rotulo, materia, modulo, secoes, descricao = '' } = Astro.props;
---
<Base title={`${titulo} · ${materia.titulo}`} description={descricao}>
  <script is:inline>
    /* aplica o modo leitura salvo antes de desenhar a página (evita piscar) */
    try { if (localStorage.getItem('caderno-lendo') === '1') { var d = document.documentElement; d.classList.add('lendo'); d.style.setProperty('--z', Math.min(2, Math.max(1.2, (innerWidth - 48) / 900)).toFixed(3)); } } catch (e) {}
  </script>
  <div class="progress" id="progress"></div>
  <div id="pop" role="dialog" aria-live="polite"></div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><marker id="mnarrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="mnarrow"/></marker></defs></svg>

  <div class="layout">
    <aside class="side">
      <details class="side-box" id="side-box" open>
        <summary>Nesta página</summary>
        <a class="side-back" href={url('/')}>← {site.titulo}</a>
        <p class="side-course">{modulo.titulo} · {materia.titulo}</p>
        <p class="side-aula"><i>{rotulo}</i>{titulo}</p>
        <nav class="toc side-group" aria-label="Nesta página">
          <ol>
            {secoes.map(([id, nome], i) => (
              <li><a href={`#${id}`}><i>{String(i + 1).padStart(2, '0')}</i>
                {id === 'glossario' ? <span>{nome} (<span id="gl-count">0</span> termos)</span> : <span>{nome}</span>}
              </a></li>
            ))}
          </ol>
        </nav>
      </details>
    </aside>
    <main class="content">
      <slot />
    </main>
  </div>
  <button id="oculos" class="oculos-btn" type="button" aria-pressed="false" aria-label="Modo leitura" title="Colocar os óculos (modo leitura)">
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle class="lente" cx="9.5" cy="18" r="5.5" /><circle class="lente" cx="22.5" cy="18" r="5.5" />
      <path d="M15 17.2q1-1.4 2 0" /><path d="M4 17l-1.6-4.5M28 17l1.6-4.5" />
    </svg>
  </button>
</Base>
