---
import Base from '../layouts/Base.astro';
import ModoSwitch from '../components/ModoSwitch.astro';
import { site, modulos, aulasDe, eixosDe, hrefRevisao, hrefRevisaoEixo, hrefGlossario, glossarioGlobal, tempoAula, formatarTempo } from '../lib/catalogo.js';
const nTermos = Object.keys(glossarioGlobal).length;
---
<Base title={site.titulo} description={site.subtitulo}>
  <ModoSwitch />
  <main class="home">
    <header class="home-head">
      <h1>{site.titulo}</h1>
      <p class="home-sub">{site.subtitulo}</p>
      <a class="home-gl" href={hrefGlossario}><span>Glossário coletivo</span><span class="muted">{nTermos} termos de todas as aulas</span><span aria-hidden="true">→</span></a>
    </header>

    {modulos.map((mod) => (
      <section class="home-mod" aria-labelledby={`h-${mod.slug}`}>
        <h2 class="mod-title" id={`h-${mod.slug}`}>{mod.titulo}</h2>
        {mod.materias.map((mat) => {
          const lista = aulasDe(mod.slug, mat.slug);
          const eixos = eixosDe(mod.slug, mat.slug);
          const variosEixos = eixos.length > 1;
          return (
            <section class="home-area" id={`${mod.slug}-${mat.slug}`}>
              <div class="area-head">
                <div>
                  <h3>{mat.titulo}</h3>
                  {mat.descricao && <p>{mat.descricao}</p>}
                </div>
                {!!lista.length && <a class="rev-link" href={hrefRevisao(mod.slug, mat.slug)}>{variosEixos ? 'Revisão da matéria →' : 'Revisão para a prova →'}</a>}
              </div>
              {lista.length === 0 && <p class="area-vazia">Nenhuma aula ainda.</p>}
              {eixos.map((eixo) => (
                <div class="home-eixo">
                  {variosEixos && (
                    <div class="eixo-head">
                      <div>
                        <h4>{eixo.titulo}</h4>
                        {eixo.descricao && <p>{eixo.descricao}</p>}
                      </div>
                      <a class="rev-link" href={hrefRevisaoEixo(mod.slug, mat.slug, eixo.slug)}>Revisão do eixo →</a>
                    </div>
                  )}
                  <ol class="aula-list">
                    {eixo.aulas.map((a) => (
                      <li>
                        <a class="aula-row" href={a.href} data-consulta={a.hrefConsulta || undefined}>
                          <span class="aula-num">{a.numero}</span>
                          <span class="aula-body">
                            <span class="aula-title">{a.titulo}</span>
                            <span class="aula-resumo">{a.resumo}</span>
                            <span class="aula-tags">{(a.topicos || []).map((t) => <span>{t}</span>)}</span>
                          </span>
                          <span class="aula-meta"><span class="aula-tempo">~{formatarTempo(tempoAula(a).minutos)} de leitura</span></span>
                          <span class="aula-go" aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))}
            </section>
          );
        })}
      </section>
    ))}
  </main>
</Base>

<script>
  import { initModo } from '../lib/modo.js';
  initModo();
</script>

<style>
  .home{max-width:880px;margin:0 auto;padding:clamp(48px,10vh,104px) 24px 96px}
  .home h1{font-size:clamp(2rem,5vw,2.9rem);margin:0 0 .5rem}
  .home-sub{font-size:1.1rem;color:var(--fg2);margin:0 0 1.4rem;max-width:560px}
  .home-gl{display:inline-flex;gap:12px;align-items:baseline;padding:10px 16px;border:1px solid var(--line);border-radius:999px;text-decoration:none;color:var(--fg);font-weight:500;margin-bottom:3rem;transition:border-color .2s,background .2s}
  .home-gl:hover{border-color:var(--accent);background:var(--accent-soft)}
  .home-gl .muted{font-weight:400;font-size:.88rem}
  .mod-title{font-size:.78rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 18px}
  .home-area{margin-bottom:2.6rem}
  .area-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--line);margin-bottom:4px}
  .area-head h3{font-size:1.25rem;margin:0 0 2px}
  .area-head p{font-size:.9rem;color:var(--muted);margin:0}
  .rev-link{font-size:.85rem;text-decoration:none;white-space:nowrap}
  .home-eixo{margin-top:6px}
  .eixo-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding:22px 8px 6px}
  .eixo-head h4{font-size:.8rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);margin:0 0 3px}
  .eixo-head p{font-size:.86rem;color:var(--muted);margin:0;max-width:560px}
  .area-vazia{color:var(--muted);font-size:.92rem;padding:14px 8px;margin:0}
  .aula-list{list-style:none;margin:0;padding:0}
  .aula-list li{border-bottom:1px solid var(--line)}
  .aula-row{display:grid;grid-template-columns:48px minmax(0,1fr) auto 24px;gap:6px 20px;align-items:start;padding:22px 8px;text-decoration:none;color:inherit;border-radius:10px;transition:background .2s}
  .aula-row:hover{background:var(--surface2)}
  .aula-row:hover .aula-go{color:var(--accent);transform:translateX(3px)}
  .aula-num{font-family:var(--f-mono);font-size:.9rem;color:var(--muted);padding-top:3px}
  .aula-body{display:flex;flex-direction:column;gap:6px;min-width:0}
  .aula-title{font-weight:600;font-size:1.15rem;color:var(--fg)}
  .aula-resumo{color:var(--fg2);font-size:.95rem;line-height:1.55}
  .aula-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
  .aula-tags span{font-size:.74rem;padding:2px 9px;border-radius:999px;background:var(--surface2);color:var(--muted);border:1px solid var(--line)}
  .aula-meta{font-size:.8rem;color:var(--muted);padding-top:5px;white-space:nowrap;display:flex;flex-direction:column;align-items:flex-end;gap:2px}
  .aula-tempo{font-family:var(--f-mono);font-size:.74rem}
  .aula-go{color:var(--muted);padding-top:2px;transition:transform .2s,color .2s}
  @media (max-width:640px){.aula-row{grid-template-columns:36px minmax(0,1fr)}.aula-meta,.aula-go{display:none}.area-head,.eixo-head{flex-direction:column;align-items:flex-start}}
</style>
