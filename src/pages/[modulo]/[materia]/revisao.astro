---
/* Revisão para a prova da matéria inteira (todas as aulas, de todos os eixos). */
import RevisaoPagina from '../../../components/RevisaoPagina.astro';
import { modulos, aulasDe, eixosDe, hrefRevisaoEixo } from '../../../lib/catalogo.js';

export function getStaticPaths() {
  return modulos.flatMap((mod) => mod.materias
    .filter((mat) => aulasDe(mod.slug, mat.slug).length)
    .map((mat) => ({ params: { modulo: mod.slug, materia: mat.slug }, props: { mod, mat } })));
}
const { mod, mat } = Astro.props;
const eixos = eixosDe(mod.slug, mat.slug);
const outras = eixos.length > 1 ? eixos.map((e) => ({ href: hrefRevisaoEixo(mod.slug, mat.slug, e.slug), rotulo: `Só ${e.titulo} →` })) : [];
---
<RevisaoPagina mod={mod} mat={mat} lista={aulasDe(mod.slug, mat.slug)} kicker={`${mod.titulo} · ${mat.titulo}`} descricao={`Revisão de ${mat.titulo}`} outras={outras} />
