---
import Aula from '../../layouts/Aula.astro';
import { aulas } from '../../data/aulas.js';
// O conteúdo é HTML puro (cheio de { } da notação de conjuntos), por isso entra como texto bruto.
import conteudo from '../../aulas/01-conceitos/conteudo.html?raw';
const aula = aulas.find((a) => a.slug === '01-conceitos');
---
<Aula aula={aula}>
  <Fragment set:html={conteudo} />
</Aula>

<script>
  import { initChrome } from '../../lib/chrome.js';
  import { initGlossary } from '../../lib/glossary.js';
  import glossario from '../../aulas/01-conceitos/glossario.js';
  import '../../aulas/01-conceitos/figuras.js';
  import '../../aulas/01-conceitos/loops.js';
  initGlossary(glossario);
  initChrome();
</script>
